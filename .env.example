# Модели Ollama. Для 8 ГБ ОЗУ: qwen3:4b (~2.5 ГБ, лицензия Apache 2.0) + bge-m3 (~1.2 ГБ, MIT).
LLM_MODEL=qwen3:4b
# Запасная лёгкая модель: скачивается вместе с основной и входит в офлайн-комплект.
# Если ПК не тянет qwen3:4b, поставьте LLM_MODEL=qwen2.5:1.5b и выполните `docker compose up -d`.
LLM_MODEL_LITE=qwen2.5:1.5b
EMBED_MODEL=bge-m3

# Порт веб-интерфейса на хосте
APP_PORT=8000

# Контекст модели в токенах (больше — медленнее и больше памяти)
LLM_NUM_CTX=4096
# Потоков CPU для модели (i3-12100: 4 физических ядра)
LLM_NUM_THREAD=4

# Сколько фрагментов передавать модели при ответе
TOP_K=5

# Краткие ответы (1–3 предложения, без рассуждений). true — подробные по умолчанию.
# В интерфейсе можно переключить галочкой «подробный ответ».
ANSWER_DETAILED=false
ANSWER_MAX_TOKENS=250
# Режим рассуждений Qwen3 (<think>). Выключен: на CPU он в разы медленнее.
LLM_THINK=false

# OCR сканов
OCR_ENABLED=true
OCR_LANG=rus+eng

# Противоречия: проверять каждый новый документ автоматически
CONTRA_AUTO=true
# Порог смыслового сходства фрагментов, при котором пара отправляется модели (0..1).
# Ниже — больше проверок (медленнее, полнее), выше — быстрее, но можно пропустить конфликт.
CONTRA_SIM_THRESHOLD=0.55
CONTRA_NEIGHBORS=3
CONTRA_MAX_PAIRS=300

# Папка на хосте, откуда PDF подхватываются автоматически (монтируется в /watch)
WATCH_HOST_DIR=./inbox
WATCH_INTERVAL_SEC=300

# SQL-источник распарсенных документов (нужен драйвер в requirements.txt), например:
# SQL_SOURCE_URL=postgresql+psycopg://user:pass@db-host:5432/docs
# SQL_SOURCE_QUERY=SELECT id, title, text, doc_date, doc_number FROM documents
SQL_SOURCE_URL=
